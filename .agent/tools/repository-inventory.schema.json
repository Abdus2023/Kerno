{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"agent.repository-inventory/1",
  "type":"object",
  "required":["schema","repository","ref","snapshot_commit","files","directories","generated_at"],
  "properties":{
    "schema":{"const":"agent.repository-inventory/1"},
    "repository":{"type":"string","minLength":1},
    "ref":{"type":"string","minLength":1},
    "snapshot_commit":{"type":"string","pattern":"^[0-9a-fA-F]{7,64}$"},
    "files":{"type":"array","items":{"type":"object","required":["path"],"properties":{"path":{"type":"string","minLength":1},"size":{"type":"integer","minimum":0},"content":{"type":"string"}},"additionalProperties":false}},
    "directories":{"type":"array","items":{"type":"string"}},
    "generated_at":{"type":"string","format":"date-time"}
  },
  "additionalProperties":false
}
