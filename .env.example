# .env.example
# Copy to .env, fill in your values

# ═══════════════════════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════════════════════

OPENROUTER_API_KEY=sk-or-v1-...
WEBUI_SECRET_KEY=                   # Generate: openssl rand -hex 32


# ═══════════════════════════════════════════════════════
# LLM SETTINGS
# ═══════════════════════════════════════════════════════

# Primary model (used for most sessions)
KERNO_MODEL=anthropic/claude-opus-4-5

# Executor model for hierarchical loop (cheaper)
# Leave empty to use KERNO_MODEL for everything
KERNO_EXECUTOR_MODEL=meta-llama/llama-3.1-70b-instruct


# ═══════════════════════════════════════════════════════
# SERVER SETTINGS
# ═══════════════════════════════════════════════════════

PORT=8001
HOST=0.0.0.0

# Kernel pool
KERNO_POOL_SIZE=3               # Increase for higher concurrency
KERNO_MAX_CELLS=50              # Max cells per session
KERNO_CELL_TIMEOUT=120          # Seconds per cell

# Loop strategy
KERNO_DEFAULT_LOOP=reactive     # reactive | reflect | plan


# ═══════════════════════════════════════════════════════
# AUTH (optional)
# ═══════════════════════════════════════════════════════

# Enable API key authentication
KERNO_ENABLE_AUTH=false

# API keys: comma-separated key:userid:name
# Example: abc123:alice:Alice,def456:bob:Bob
KERNO_API_KEYS=

# Key for Open WebUI to use when calling Kerno
KERNO_WEBUI_KEY=kerno-local


# ═══════════════════════════════════════════════════════
# STORAGE
# ═══════════════════════════════════════════════════════

KERNO_MEMORY_PATH=/data/memory.json
KERNO_SESSIONS_PATH=/sessions
KERNO_LOG_PATH=/data/kerno.log


# ═══════════════════════════════════════════════════════
# FEATURES
# ═══════════════════════════════════════════════════════

KERNO_ENABLE_MEMORY=true        # Cross-session memory
KERNO_SHOW_CODE=true            # Show generated code in UI
KERNO_SHOW_CELL_NUMBERS=true    # Show "Cell 1", "Cell 2"...
KERNO_SAVE_NOTEBOOKS=true       # Save .ipynb artifacts


# ═══════════════════════════════════════════════════════
# OPEN WEBUI
# ═══════════════════════════════════════════════════════

WEBUI_PORT=3000
ENABLE_SIGNUP=true
